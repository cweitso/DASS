DASS_LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# DASS_DATABASE_URL is deliberately unset here. docker-compose picks the target
# per service: api-server / worker / autoscaler go through pgbouncer:6432, while
# the scheduler connects to postgres:5432 directly because its leader election
# uses a session-level advisory lock that transaction pooling would drop.
# Setting it here would be injected into every service via env_file and collapse
# that split into one target.
# DASS_DATABASE_URL=postgresql+psycopg://dass:dass@postgres:5432/dass
DASS_REPLICA_DATABASE_URL=postgresql+psycopg://dass:dass@postgres-replica:5432/dass
DASS_DATABASE_ECHO=false

# --- Queue ------------------------------------------------------------------
DASS_QUEUE_BACKEND=sqs
DASS_QUEUE_NAME=dass-tasks
DASS_QUEUE_NAME_NORMAL=dass-tasks-normal
DASS_QUEUE_NAME_SCHEDULED=dass-tasks-scheduled
DASS_QUEUE_NAME_RETRY=dass-tasks-retry
DASS_AWS_REGION=us-east-1
DASS_AWS_ACCESS_KEY_ID=dass
DASS_AWS_SECRET_ACCESS_KEY=dass
DASS_SQS_ENDPOINT_URL=http://localstack:4566

# --- Timing -----------------------------------------------------------------
DASS_SCHEDULER_INTERVAL_SECONDS=5
DASS_WORKER_VISIBILITY_TIMEOUT_SECONDS=30
DASS_AUTOSCALER_INTERVAL_SECONDS=30

# DASS_WORKER_ID is deliberately unset. docker-compose gives each service its own
# identity (api-server / scheduler / worker / autoscaler) and the DB layer sizes
# its connection pool from it. A fixed value here would apply to every service.
# DASS_WORKER_ID=worker-1

# --- Execution --------------------------------------------------------------
# Shell actions run arbitrary commands inside a container. Set to false to reject
# new shell jobs on any deployment reachable beyond your machine.
DASS_SHELL_EXECUTION_ENABLED=true

# --- Frontend ---------------------------------------------------------------
DASS_BACKEND_URL=http://api-server:8000
DASS_CORS_ORIGINS=http://localhost,http://127.0.0.1,https://localhost:8443,https://127.0.0.1:8443,http://localhost:3000,http://127.0.0.1:3000
