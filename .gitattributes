# Let Git normalise line endings: CRLF in the working tree on Windows, LF in the repo.
* text=auto

# These always run inside Linux containers, so they must keep LF regardless of
# the host they were edited on.
*.sh text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile* text eol=lf
