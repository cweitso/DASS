{
  "uid": "dass-overview",
  "title": "DASS · Overview",
  "tags": [
    "dass"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 9,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Jobs in DB",
      "id": 1,
      "description": "Every job definition in the jobs table: Normal + Scheduled (broken out in Jobs (definitions) below). It matches the Normal figure only while Scheduled is 0.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "dass_jobs_total_count",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "stat",
      "title": "Scheduler DB jobs",
      "id": 99,
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(dass_scheduler_jobs_upcoming_count) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "description": "Jobs armed in the scheduler: enabled cron jobs whose next_fire_at is still in the future. Overdue jobs (next_fire_at < now) and one-time jobs are excluded."
    },
    {
      "type": "stat",
      "title": "Tasks pending",
      "id": 2,
      "description": "Messages waiting across all SQS queues (ApproximateNumberOfMessages / visible) — the real backlog of tasks enqueued but not yet picked up by a worker. Replaces the old DB status='pending' count, which never drains because task rows are never deleted, so it conflated live backlog with all-time history.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(dass_sqs_messages_visible) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Tasks running",
      "id": 4,
      "description": "DB snapshot: rows with status='running' — the single source of truth for 'running'. ≈ (workers × per-worker concurrency) actually claimed into the DB.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(dass_tasks_by_status_count{status=\"running\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "stat",
      "title": "Success/min",
      "id": 5,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "increase(dass_tasks_succeeded_total[1m])",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Failed/min",
      "id": 6,
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "increase(dass_tasks_failed_total[1m])",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      }
    },
    {
      "type": "row",
      "id": 108,
      "title": "Jobs & task runs",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Jobs (definitions)",
      "id": 110,
      "description": "A job is a definition in the jobs table. Normal = one-time, run on demand, no cron. Scheduled = has a cron and is owned by the scheduler. The two add up to Jobs in DB above.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "Normal (on-demand, no cron)",
          "expr": "sum(dass_jobs_by_enabled_count{job_type=\"normal\"}) or vector(0)"
        },
        {
          "refId": "B",
          "instant": true,
          "legendFormat": "Scheduled (cron)",
          "expr": "sum(dass_jobs_by_enabled_count{job_type=\"scheduled\"}) or vector(0)"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Task runs (executions)",
      "id": 111,
      "description": "Where each run came from. Trigger-now = a cron job someone ran by hand. Scheduler-dispatched = the scheduler firing it on schedule. Outcomes are in Task outcomes below.",
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 16,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "Trigger-now (manual on scheduled job)",
          "expr": "sum(dass_tasks_by_job_and_trigger_count{job_type=\"scheduled\",trigger_type=\"manual\"}) or vector(0)"
        },
        {
          "refId": "B",
          "instant": true,
          "legendFormat": "Scheduler-dispatched",
          "expr": "sum(dass_tasks_by_trigger_total{trigger_type=\"scheduled\"}) or vector(0)"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      }
    },
    {
      "type": "row",
      "id": 106,
      "title": "Task throughput (cumulative counters)",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Task outcomes (cumulative)",
      "id": 112,
      "description": "The life of a failing job: first failure, then retries, then giving up (final_failed).\n- Enqueued: runs dispatched in total.\n- Succeeded: runs that finished successfully.\n- Failed runs (incl. retries): every failed attempt, so retries inflate it above the number of jobs that truly failed.\n- Retries (re-runs): how many of those attempts were re-runs (retry_count > 0).\n- Final failures (gave up): retries exhausted and still failing, which is the real failure count.\nFailed runs = first-attempt failures + failed retries; final failures are a subset of failed runs.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "Enqueued (every run)",
          "expr": "sum(dass_tasks_created_total) or vector(0)"
        },
        {
          "refId": "B",
          "instant": true,
          "legendFormat": "Succeeded",
          "expr": "sum(dass_tasks_succeeded_total) or vector(0)"
        },
        {
          "refId": "C",
          "instant": true,
          "legendFormat": "Failed runs (incl. retries)",
          "expr": "sum(dass_tasks_failed_total) or vector(0)"
        },
        {
          "refId": "D",
          "instant": true,
          "legendFormat": "Retries (re-runs)",
          "expr": "sum(dass_tasks_retried_total) or vector(0)"
        },
        {
          "refId": "E",
          "instant": true,
          "legendFormat": "Final failures (gave up)",
          "expr": "sum(dass_tasks_final_failed_total) or vector(0)"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tasks processed (cumulative)",
      "id": 63,
      "description": "Monotonic staircase — every enqueued/succeeded/failed task leaves a permanent step, so short tasks are always visible here even though the gauge panels above miss them.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "dass_tasks_created_total",
          "legendFormat": "enqueued",
          "refId": "A"
        },
        {
          "expr": "dass_tasks_succeeded_total",
          "legendFormat": "succeeded",
          "refId": "B"
        },
        {
          "expr": "dass_tasks_failed_total",
          "legendFormat": "failed",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2,
            "drawStyle": "line"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Scheduled dispatches (/min)",
      "id": 107,
      "description": "Scheduler enqueues per minute, from a cumulative COUNTER (dass_tasks_by_trigger_total{trigger_type='scheduled'}). Unlike the SQS 'visible' gauge — which reads ~0 because each scheduled task is consumed in <1s — this leaves one tick per dispatch.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "increase(dass_tasks_by_trigger_total{trigger_type=\"scheduled\"}[1m])",
          "refId": "A",
          "legendFormat": "scheduled/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "row",
      "id": 100,
      "title": "Live task counts (DB, by queue)",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Tasks waiting (pending, by queue)",
      "id": 10,
      "description": "Tasks waiting to run (status='pending'), bucketed by the queue they were routed to. Counted from the database rather than SQS, because a task is usually consumed within one scrape interval and the SQS gauge reads zero. All three lines sit at 0 while idle.",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
